# Alternative if SQLite extensions are unavailable. Create the MySQL database first.
# COPY ONLY THESE KEYS into your original .env. Retain your APP_KEY.
APP_URL=http://127.0.0.1:8000
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=histrangers
DB_USERNAME=root
# Set DB_PASSWORD for your actual Laragon MySQL user; empty only if that is how your local DB is configured.
DB_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
