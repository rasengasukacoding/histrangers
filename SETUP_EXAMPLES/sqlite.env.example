# COPY ONLY THESE KEYS into your original .env. Do not replace its APP_KEY.
APP_URL=http://127.0.0.1:8000
DB_CONNECTION=sqlite
# On Laravel 13, database/database.sqlite is the default SQLite database file.
# If an existing DB_DATABASE key contains a different path, remove or update it.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
